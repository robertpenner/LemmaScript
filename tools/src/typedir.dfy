{
  match a {
    case array_(e) => tyEqualRefl_ensures(e);
    case set_(e) => tyEqualRefl_ensures(e);
    case optional(e) => tyEqualRefl_ensures(e);
    case map_(k, v) => { tyEqualRefl_ensures(k); tyEqualRefl_ensures(v); }
    case tuple(es) =>
      forall i | 0 <= i < |es| ensures tyEqual(es[i], es[i]) { tyEqualRefl_ensures(es[i]); }
    case fn(ps, r) =>
      forall i | 0 <= i < |ps| ensures tyEqual(ps[i], ps[i]) { tyEqualRefl_ensures(ps[i]); }
      tyEqualRefl_ensures(r);
    case string_(vs) => if vs.Some? { stringsEqualRefl_ensures(vs.value); }
    case _ => {}
  }
}

function tyEqualSym(a: Ty, b: Ty): bool
{
  (tyEqual(a, b) == tyEqual(b, a))
}

lemma tyEqualSym_ensures(a: Ty, b: Ty)
  ensures (tyEqualSym(a, b) == true)
{
  match a {
    case array_(e) => if b.array_? { tyEqualSym_ensures(e, b.elem); }
    case set_(e) => if b.set_? { tyEqualSym_ensures(e, b.elem); }
    case optional(e) => if b.optional? { tyEqualSym_ensures(e, b.inner); }
    case map_(k, v) => if b.map_? { tyEqualSym_ensures(k, b.key); tyEqualSym_ensures(v, b.value); }
    case tuple(es) =>
      if b.tuple? && |es| == |b.elems| {
        forall i | 0 <= i < |es| ensures tyEqual(es[i], b.elems[i]) == tyEqual(b.elems[i], es[i]) {
          tyEqualSym_ensures(es[i], b.elems[i]);

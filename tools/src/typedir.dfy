        if |ps| == |b.params| {
          forall i | 0 <= i < |ps| ensures tyEqual(ps[i], b.params[i]) == tyEqual(b.params[i], ps[i]) {
            tyEqualSym_ensures(ps[i], b.params[i]);
          }
        }
        tyEqualSym_ensures(r, b.result);
      }
    case string_(vs) =>
      if b.string_? && vs.Some? && b.values.Some? { stringsEqualSym_ensures(vs.value, b.values.value); }
    case _ => {}
  }

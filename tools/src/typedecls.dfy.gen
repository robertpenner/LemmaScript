// Generated by lsc from typedecls.ts

datatype Option<T> = None | Some(value: T)

function SeqFind<T>(s: seq<T>, p: T -> bool): Option<T>
  ensures SeqFind(s, p).Some? ==> p(SeqFind(s, p).value)
  ensures SeqFind(s, p).Some? ==> SeqFind(s, p).value in s
  ensures SeqFind(s, p).Some? ==>
    exists i: nat :: i < |s| && s[i] == SeqFind(s, p).value && p(s[i]) &&
                     (forall j: nat :: j < i ==> !p(s[j]))
  ensures SeqFind(s, p).None? ==> forall i :: 0 <= i < |s| ==> !p(s[i])
  decreases |s|
{
  if |s| == 0 then None
  else if p(s[0]) then Some(s[0])
  else SeqFind(s[1..], p)
}

function StringIndexOf(s: string, sub: string): int
  ensures StringIndexOf(s, sub) == -1
       || (0 <= StringIndexOf(s, sub) <= |s| - |sub| && s[StringIndexOf(s, sub)..StringIndexOf(s, sub) + |sub|] == sub)
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: int): int
  ensures StringIndexOfFrom(s, sub, from) == -1
       || (0 <= StringIndexOfFrom(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFrom(s, sub, from)..StringIndexOfFrom(s, sub, from) + |sub|] == sub
           && StringIndexOfFrom(s, sub, from) >= from)
{
  StringIndexOfFromN(s, sub, if from < 0 then 0 else from)
}

function StringIndexOfFromN(s: string, sub: string, from: nat): int
  decreases |s| - from
  ensures StringIndexOfFromN(s, sub, from) == -1
       || (from <= StringIndexOfFromN(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFromN(s, sub, from)..StringIndexOfFromN(s, sub, from) + |sub|] == sub)
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFromN(s, sub, from + 1)
}

predicate StringMatchesAt(s: string, sub: string, j: int)
{
  0 <= j && j + |sub| <= |s| && s[j..j + |sub|] == sub
}

function StringLastIndexOf(s: string, sub: string): int
  ensures StringLastIndexOf(s, sub) == -1
       || (0 <= StringLastIndexOf(s, sub) <= |s| - |sub| && StringMatchesAt(s, sub, StringLastIndexOf(s, sub)))
  ensures forall j {:trigger StringMatchesAt(s, sub, j)} ::
            StringLastIndexOf(s, sub) < j ==> !StringMatchesAt(s, sub, j)
{
  StringLastIndexOfFrom(s, sub, |s|)
}

function StringLastIndexOfFrom(s: string, sub: string, from: nat): int
  decreases from
  ensures StringLastIndexOfFrom(s, sub, from) == -1
       || (0 <= StringLastIndexOfFrom(s, sub, from) <= from
           && StringMatchesAt(s, sub, StringLastIndexOfFrom(s, sub, from)))
  ensures forall j {:trigger StringMatchesAt(s, sub, j)} ::
            StringLastIndexOfFrom(s, sub, from) < j <= from ==> !StringMatchesAt(s, sub, j)
{
  if StringMatchesAt(s, sub, from) then from as int
  else if from == 0 then -1
  else StringLastIndexOfFrom(s, sub, from - 1)
}

type i__type(==)

type TypeDecls = seq<TypeDeclInfo>

datatype TypeDeclInfo = TypeDeclInfo(name: string, typeParams: Option<seq<string>>, kind: string, values: Option<seq<string>>, discriminant: Option<string>, variants: Option<seq<VariantInfo>>, fields: Option<seq<FieldInfo>>, aliasOf: Option<string>, aliasOfTy: Option<Ty>, constEnumMembers: Option<seq<i__type>>)

datatype VariantInfo = VariantInfo(name: string, fields: seq<FieldInfo>)

datatype FieldInfo = FieldInfo(name: string, tsType: string, type_: Option<Ty>, optionalKey: Option<bool>)

datatype Ty = bool_ | nat_(big: Option<bool>) | int_(big: Option<bool>) | real_ | string_(values: Option<seq<string>>) | void | array_(elem: Ty) | tuple(elems: seq<Ty>) | map_(key: Ty, value: Ty) | set_(elem: Ty) | optional(inner: Ty) | user(name: string) | fn(params: seq<Ty>, result: Ty) | unknown

function tyBaseName(name: string): string
{
  if (StringIndexOf(name, "<") >= 0) then
    name[0..StringIndexOf(name, "<")]
  else
    name
}

function declOf(decls: seq<TypeDeclInfo>, name: string): Option<TypeDeclInfo>
{
  SeqFind(decls, (d: TypeDeclInfo) => (d.name == name))
}

function declOfKind(decls: seq<TypeDeclInfo>, name: string, kinds: seq<string>): Option<TypeDeclInfo>
{
  var d := declOf(decls, name);
  match d {
    case Some(i_d_val) =>
      if (i_d_val.kind in kinds) then
        Option.Some(i_d_val)
      else
        Option.None
    case None =>
      Option.None
  }
}

function declOfDotted(decls: seq<TypeDeclInfo>, name: string): Option<TypeDeclInfo>
{
  var direct := declOf(decls, name);
  match direct {
    case Some(i_direct_val) =>
      Some(i_direct_val)
    case None =>
      var dotIdx := StringLastIndexOf(name, ".");
      if (dotIdx >= 0) then
        declOf(decls, name[(dotIdx + 1)..])
      else
        None
  }
}

function declOfTy(decls: seq<TypeDeclInfo>, ty: Ty): Option<TypeDeclInfo>
{
  if ty.user? then
    declOf(decls, tyBaseName(ty.name))
  else
    Option.None
}

function unionDeclOfTy(decls: seq<TypeDeclInfo>, ty: Ty): Option<TypeDeclInfo>
{
  var d := declOfTy(decls, ty);
  if (match (match d { case Some(i_oc0_val) => Option.Some(i_oc0_val.kind) case None => Option.None }) { case Some(i_value) => (i_value == "discriminated-union") case None => false }) then
    d
  else
    Option.None
}

function discriminantOf(decls: seq<TypeDeclInfo>, ty: Ty): Option<string>
{
  match unionDeclOfTy(decls, ty) {
    case Some(i_oc1_val) =>
      i_oc1_val.discriminant
    case None =>
      Option.None
  }
}

function declWithVariant(decls: seq<TypeDeclInfo>, ctorOrValue: string): Option<TypeDeclInfo>
{
  SeqFind(decls, (d: TypeDeclInfo) => (((d.kind == "discriminated-union") || (d.kind == "string-union")) && (match (match d.variants { case Some(i_oc2_val) => Option.Some((exists v :: v in i_oc2_val && (v.name == ctorOrValue))) case None => Option.None }) { case Some(i_value) => (if i_value then i_value else (match (match d.values { case Some(i_oc3_val) => Option.Some((ctorOrValue in i_oc3_val)) case None => Option.None }) { case Some(i_oc4_val) => i_oc4_val case None => false })) case None => (match (match d.values { case Some(i_oc3_val) => Option.Some((ctorOrValue in i_oc3_val)) case None => Option.None }) { case Some(i_oc4_val) => i_oc4_val case None => false }) })))
}

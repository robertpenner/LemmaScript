    case set_(e) => tyEqualTrans_ensures(e, i_b.elem, c.elem);
    case optional(e) => tyEqualTrans_ensures(e, i_b.inner, c.inner);
    case map_(k, v) => { tyEqualTrans_ensures(k, i_b.key, c.key); tyEqualTrans_ensures(v, i_b.value, c.value); }

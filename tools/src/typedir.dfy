datatype Option<T> = None | Some(value: T)

function CallbackIndices(n: nat): (r: seq<int>)
  ensures |r| == n
  ensures forall i :: 0 <= i < n ==> r[i] == i
  ensures forall i :: i in r <==> 0 <= i < n
{
  if n == 0 then [] else CallbackIndices(n - 1) + [n - 1]
}


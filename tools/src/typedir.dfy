      case map_(i_a_key, i_a_value) =>
        var bm := b;
        (tyEqual(i_a_key, bm.key) && tyEqual(i_a_value, bm.value))
      case optional(i_a_inner) =>
        tyEqual(i_a_inner, b.inner)
      case user(i_a_name) =>
        (i_a_name == b.name)
      case fn(i_a_params, i_a_result) =>
        var bf := b;
        (((|i_a_params| == |bf.params|) && (var i_callbackSource1: seq<Ty> := i_a_params; Std.Collections.Seq.All(CallbackIndices(|i_callbackSource1|), (i_callbackIndex1: int) => (((0 <= i_callbackIndex1) && (i_callbackIndex1 < |i_callbackSource1|)) && (var p: Ty := i_callbackSource1[i_callbackIndex1]; (var i: int := i_callbackIndex1; tyEqual(p, bf.params[i]))))))) && tyEqual(i_a_result, bf.result))
      case string_(i_a_values) =>
        var av := i_a_values;
        var bv := b.values;
        match av {
          case Some(i_av_val) =>
            match bv {
              case Some(i_bv_val) =>
                stringsEqual(i_av_val, i_bv_val)
              case None =>
                false
            }
          case None =>
            match bv {
              case Some(i_) =>
                false
              case None =>
                true
            }
        }
      case int_(i_a_big) =>
        (!((match i_a_big { case Some(i_value) => !(i_value) case None => true })) == !((match b.big { case Some(i_value) => !(i_value) case None => true })))
      case nat_(i_a_big) =>

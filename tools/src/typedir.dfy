datatype TConst = TConst(name: string, ty: Ty, value: TExpr)

datatype TExtern = TExtern(qualified: string, flat: string, typeParams: seq<string>, params: seq<TParam>, returnTy: Ty, requires_: seq<TExpr>, ensures_: seq<TExpr>, impure: bool)

datatype TModule = TModule(file: string, typeDecls: seq<TypeDeclInfo>, externs: seq<TExtern>, constants: seq<TConst>, functions: seq<TFunction>, classes: seq<TClass>)

function Ty_kind(t: Ty): string
{
  match t {
    case bool_ =>
      "bool"
    case nat_(i_0) =>
      "nat"
    case int_(i_0) =>
      "int"
    case real_ =>
      "real"
    case string_(i_0) =>
      "string"
    case void =>
      "void"
    case array_(i_0) =>
      "array"
    case tuple(i_0) =>
      "tuple"
    case map_(i_0, i_1) =>
      "map"
    case set_(i_0) =>
      "set"
    case optional(i_0) =>
      "optional"
    case user(i_0) =>
      "user"
    case fn(i_0, i_1) =>
      "fn"
    case unknown =>
      "unknown"
  }
}

function isBigInt(ty: Ty): bool
{
  ((ty.int_? || ty.nat_?) && !((match ty.big { case Some(i_value) => !(i_value) case None => true })))
}

function stringsEqual(as_: seq<string>, bs: seq<string>): bool
{
  if (|as_| != |bs|) then
    false
  else
    ((|as_| == 0) || ((as_[0] == bs[0]) && stringsEqual(as_[1..], bs[1..])))
}

